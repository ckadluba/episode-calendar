project_id = "episode-calendar-67234"
region     = "europe-west3"
image      = "europe-west3-docker.pkg.dev/episode-calendar-67234/episode-calendar/app:latest"
# Set locally; never commit the real value.
database_password = "replace-with-a-random-value-of-at-least-16-characters"
# Keep false until Secret Manager has all required versions.
deploy_cloud_run = false
# Enable only after the episode-calendar-import Cloud Run Job exists.
enable_import_schedule = false
cors_origins = "http://localhost:5173,http://127.0.0.1:5173,https://episode-calendar-67234.web.app"
