POSTGRES_DB=episode_calendar
POSTGRES_USER=episode_calendar
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://episode_calendar:change-me-for-local-development@localhost:5432/episode_calendar
JOYN_API_KEY=
RTLPLUS_OIDC_CLIENT_SECRET=
IMPORT_DELAY_SECONDS=1.0
IMPORT_MAX_RETRIES=3
IMPORT_BACKOFF_SECONDS=1.0
SERIES_CONFIG_PATH=config/series.json
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# Passwordless login. Without a key the login email is logged instead of sent.
BREVO_API_KEY=
AUTH_EMAIL_FROM=Episode Calendar <login@example.com>
AUTH_LINK_BASE_URL=http://localhost:5173
