{
  "name": "Episode Calendar",
  "dockerComposeFile": ["../compose.yaml", "compose.yaml"],
  "service": "devcontainer",
  "runServices": ["db", "devcontainer"],
  "workspaceFolder": "/workspaces/episode-calendar",
  "remoteUser": "vscode",
  "initializeCommand": "test -f .env || cp .env.example .env",
  "postCreateCommand": "uv sync --frozen",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Episode Calendar API"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff"],
      "settings": {
        "python.defaultInterpreterPath": "/home/vscode/.venvs/episode-calendar/bin/python"
      }
    }
  }
}
